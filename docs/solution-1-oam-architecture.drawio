        <mxCell id="cost-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#FFF2E8,#3A2A18);strokeColor=#ED7100;dashed=1;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontSize=11;fontColor=light-dark(#232F3E,#F4F4F4);fontFamily=Helvetica;" value="&lt;b&gt;THE COST CONTROL&lt;/b&gt;&lt;div&gt;Ansible reads &lt;i&gt;ansible_mounts&lt;/i&gt; and templates the agent config from the host's own filesystems. The fstype filter keeps this to 2-4 metrics per host — &lt;b&gt;resources: [&quot;*&quot;] would cost ~11x&lt;/b&gt; (50,000 vs 3,000 metrics at 1,000 VMs).&lt;/div&gt;" vertex="1">
          <mxGeometry height="95" width="320" x="150" y="1065" as="geometry" />
        </mxCell>
        <mxCell id="premise-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#EDF3FF,#29393B);strokeColor=#147EBA;dashed=1;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontSize=11;fontColor=light-dark(#232F3E,#F4F4F4);fontFamily=Helvetica;" value="&lt;b&gt;WHY AN IN-GUEST AGENT IS MANDATORY&lt;/b&gt;&lt;div&gt;AWS/EC2 reports CPU and network only. AWS/EBS measures I/O activity, not occupancy — a full disk generates near-zero activity, so BurstBalance looks healthy while the application dies.&lt;/div&gt;" vertex="1">
          <mxGeometry height="95" width="380" x="510" y="1065" as="geometry" />
        </mxCell>
