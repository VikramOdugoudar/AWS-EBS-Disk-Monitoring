        </mxCell>
        <mxCell id="legend-step-1-group" connectable="0" parent="legend-outer" style="group;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="80" width="600" x="20" y="24" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-1-badge" parent="legend-step-1-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="1" vertex="1">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-1-desc" parent="legend-step-1-group" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Accounts enroll themselves&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;A StackSet auto-deploys to an OU, so moving an account into the OU is the whole onboarding step&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="548" x="52" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-2-group" connectable="0" parent="legend-outer" style="group;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="80" width="600" x="20" y="120" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-2-badge" parent="legend-step-2-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="2" vertex="1">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-2-desc" parent="legend-step-2-group" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;An event starts a playbook run&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Instance launch, tag change, or a newly onboarded account. Three triggers, no scheduler&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="548" x="52" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-3-group" connectable="0" parent="legend-outer" style="group;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="80" width="600" x="20" y="216" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-3-badge" parent="legend-step-3-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="3" vertex="1">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-3-desc" parent="legend-step-3-group" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Ansible CONFIGURES the host&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Reaches the instance over SSM Session Manager: no SSH keys, no inbound ports, no bastion&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Installs the CloudWatch agent and generates its config from the host's real filesystems, which is also the cost control&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="95" width="548" x="52" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-4-group" connectable="0" parent="legend-outer" style="group;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="80" width="600" x="20" y="330" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-4-badge" parent="legend-step-4-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="4" vertex="1">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-4-desc" parent="legend-step-4-group" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;The agent COLLECTS, continuously&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;disk_used_percent every 60 seconds, forever. Frequency is free: only unique metrics are billed&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Leaves the private subnet through the monitoring VPC endpoint, since there is no internet egress&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="95" width="548" x="52" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-5-group" connectable="0" parent="legend-outer" style="group;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="80" width="600" x="20" y="444" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-5-badge" parent="legend-step-5-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="5" vertex="1">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-5-desc" parent="legend-step-5-group" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;OAM shares the metrics for free&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;A link in each workload account points at one org-scoped sink, filtered to the CWAgent namespace&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Nothing is copied or replicated: the sink grants query access only&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="95" width="548" x="52" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-6-group" connectable="0" parent="legend-outer" style="group;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="80" width="600" x="20" y="558" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-6-badge" parent="legend-step-6-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="6" vertex="1">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-6-desc" parent="legend-step-6-group" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Alarms cover the fleet, then act&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;One Metrics Insights alarm per account per environment, so a new instance is picked up automatically&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;80 percent sends email. 90 percent snapshots then grows the volume, opt-in by tag&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;A dashboard populates itself from the same shared metrics&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="548" x="52" as="geometry" />
        </mxCell>
        <mxCell id="legend-note-paths" parent="legend-outer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#EDF3FF,#29393B);strokeColor=#147EBA;dashed=1;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontSize=13;fontColor=light-dark(#232F3E,#F4F4F4);fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;The central idea: two separate paths.&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Ansible &lt;b&gt;configures&lt;/b&gt; (occasional, and never carries a measurement). The agent &lt;b&gt;collects&lt;/b&gt; (continuous, every 60s). If Ansible stops, config goes stale. If the agent stops, metrics stop and you are blind.&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="600" x="20" y="684" as="geometry" />
        </mxCell>
        <mxCell id="legend-note-premise" parent="legend-outer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#FFF2E8,#3A2A18);strokeColor=#ED7100;dashed=1;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontSize=13;fontColor=light-dark(#232F3E,#F4F4F4);fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Why an in-guest agent is mandatory.&lt;/b&gt;&lt;/div&gt;&lt;div&gt;AWS/EC2 reports CPU and network only, and AWS/EBS measures I/O activity rather than occupancy — a full disk generates near-zero activity, so it looks healthy from outside while the application dies.&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="600" x="20" y="806" as="geometry" />
        </mxCell>
        <mxCell id="legend-line-group" connectable="0" parent="legend-outer" style="group;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="112" width="600" x="20" y="928" as="geometry" />
        </mxCell>
        <mxCell id="legend-line-bg" parent="legend-line-group" style="fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="112" width="600" as="geometry" />
        </mxCell>
        <mxCell id="legend-line-title" parent="legend-line-group" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;fontStyle=1;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="Line Styles" vertex="1">
          <mxGeometry height="26" width="152" x="12" y="6" as="geometry" />
        </mxCell>
        <mxCell id="legend-line-desc" parent="legend-line-group" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;&lt;font color=&quot;#147EBA&quot;&gt;━━━ Thick blue solid&lt;/font&gt;&lt;/b&gt;: &lt;b&gt;DATA path&lt;/b&gt; — continuous, every 60s&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font color=&quot;#ED7100&quot;&gt;- - - Dashed orange&lt;/font&gt;&lt;/b&gt;: &lt;b&gt;CONFIGURATION path&lt;/b&gt; — occasional, not in the data path&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font color=&quot;#545B64&quot;&gt;──── Gray solid&lt;/font&gt;&lt;/b&gt;: control, enrollment and alarm actions&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font color=&quot;#DD344C&quot;&gt;- - - Dashed red&lt;/font&gt;&lt;/b&gt;: remediation via an assumed cross-account role&lt;/div&gt;" vertex="1">
          <mxGeometry height="76" width="580" x="12" y="32" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>